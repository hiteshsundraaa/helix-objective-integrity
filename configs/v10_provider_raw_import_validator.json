{
  "schema_version": "v10_provider_raw_import_validator_v1",
  "validator_only": true,
  "default_plan_path": "benchmarks/v10_calibrated/provider_run_plans/pilot_v1/provider_run_plan.json",
  "default_import_root": "benchmarks/v10_calibrated/provider_imports",
  "default_output_root": "benchmarks/v10_calibrated/provider_runs",
  "external_raw_subdir": "external_raw",
  "parsed_raw_judgments_filename": "parsed_raw_judgments.jsonl",
  "required_raw_files": [
    "request_manifest",
    "raw_response"
  ],
  "optional_raw_files": [
    "raw_text"
  ],
  "allowed_response_formats": [
    "json_object_with_judgments",
    "json_array",
    "jsonl_text"
  ],
  "required_provider_metadata_fields": [
    "provider",
    "model",
    "prompt_hash",
    "case_ids",
    "request_timestamp"
  ],
  "required_response_metadata_fields": [
    "response_timestamp",
    "response_hash"
  ],
  "allow_network_calls": false,
  "allow_provider_sdk_imports": false,
  "allow_api_keys": false,
  "evidence_policy": {
    "manual_external_import_is_live_api_evidence": false,
    "manual_external_import_evidence_level_cap": 3,
    "level_4_allowed_without_locked_live_runner": false,
    "level_5_allowed": false
  },
  "notes": "Validator only. Imports externally saved raw outputs. No API calls, no SDK clients, no secrets."
}
