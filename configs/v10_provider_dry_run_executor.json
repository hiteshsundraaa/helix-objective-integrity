{
  "schema_version": "v10_provider_dry_run_executor_v1",
  "registered_before_live_provider_execution": true,
  "dry_run_mode": true,
  "default_stage": "pilot",
  "default_plan_path": "benchmarks/v10_calibrated/provider_run_plans/pilot_v1/provider_run_plan.json",
  "default_fixture_source": "synthetic_case_subset",
  "mock_provider": "dry_run_fixture",
  "mock_model": "fixture-response-generator",
  "batch_size": 10,
  "preserve_raw_responses_before_parsing": true,
  "allow_network_calls": false,
  "allow_provider_sdk_imports": false,
  "allow_api_keys": false,
  "output_root": "benchmarks/v10_calibrated/provider_runs",
  "run_id_prefix": "dry_run_pilot",
  "retry_policy_test_cases": [
    "transport_failure",
    "provider_timeout",
    "truncated_invalid_json",
    "empty_case_level_output"
  ],
  "evidence_policy": {
    "dry_run_is_provider_evidence": false,
    "dry_run_evidence_level_cap": 2,
    "level_5_allowed": false
  },
  "notes": "Dry-run executor only. No provider APIs, no network calls, no SDK clients, no secrets."
}
