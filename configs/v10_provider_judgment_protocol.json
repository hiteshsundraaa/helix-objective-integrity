{
  "schema_version": "v10_provider_judgment_protocol_v1",
  "registered_before_provider_calls": true,
  "default_run_stage": "pilot",
  "pilot_case_count": 30,
  "pilot_cases_per_family": 3,
  "pilot_sampling_seed": 42,
  "full_case_count": 300,
  "prompt_mode": "contract",
  "generic_prompt_path": "benchmarks/v10_calibrated/prompts/v10_generic_prompt.md",
  "contract_prompt_path": "benchmarks/v10_calibrated/prompts/v10_contract_prompt.md",
  "prompt_rendering_manifest_path": "benchmarks/v10_calibrated/prompts/v10_prompt_rendering_manifest.json",
  "cases_path": "benchmarks/v10_calibrated/v10_cases.jsonl",
  "normalization_config_path": "configs/v10_judgment_normalization.json",
  "benchmark_config_path": "configs/v10_benchmark_runner.json",
  "diagnostics_config_path": "configs/v10_diagnostics.json",
  "reportability_config_path": "configs/v10_reportability_gate.json",
  "provider": null,
  "model": null,
  "model_version": null,
  "temperature": 0,
  "top_p": 1,
  "max_output_tokens": 8192,
  "timeout_seconds": 120,
  "max_retries": 2,
  "retry_allowed_reasons": [
    "transport_failure",
    "provider_timeout",
    "truncated_invalid_json",
    "empty_case_level_output"
  ],
  "retry_disallowed_reasons": [
    "bad_metrics",
    "score_collapse",
    "reportability_failure",
    "low_tpr",
    "high_fpr",
    "poor_citation_rate"
  ],
  "max_pilot_cost_usd": 5.0,
  "max_full_cost_usd": 50.0,
  "evidence_level_cap_without_human_or_live_validation": 4,
  "level_5_allowed": false,
  "notes": "Protocol config only. Provider/model must be filled before live calls. No API keys or secrets."
}
